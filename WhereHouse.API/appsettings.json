{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/where-house-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} <{SourceContext}> {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Environment": "Production",
  "ConnectionString": {
    "WhereHouse": "REPLACE_ME"
  },
  "Authentication": {
    "Jwt": {
      "Secret": "WhereHouse_Default_Production_Secret_Must_Be_Overridden_Via_Env_Var!#$",
      "Issuer": "WhereHouse",
      "Audience": "WhereHouse",
      "ExpirationMinutes": 1440
    },
    "Oidc": {
      "Enabled": false,
      "ProviderName": "OIDC",
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scope": "openid profile email"
    }
  }
}
